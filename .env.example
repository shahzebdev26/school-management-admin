# Copy to .env.local and fill in. The app refuses to start if a value is missing
# or malformed — see src/lib/env.ts.
#
# WARNING: every NEXT_PUBLIC_* variable is inlined into the browser bundle and is
# therefore PUBLIC. Never put a secret, key, or token behind this prefix.

# Server-only. Where Next proxies /api/* to the backend (see src/lib/api/proxy-request.ts).
# The browser never talks to this address directly.
API_ORIGIN=http://localhost:4000

# Root domain. The admin dashboard lives at admin.<domain>.
# Locally, use `localhost` so http://localhost:3001 works.
NEXT_PUBLIC_APP_DOMAIN=localhost
